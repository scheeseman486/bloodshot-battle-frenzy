+Dictionary ENetConnection::get_security_limits() const {
+    Dictionary limits;
+    limits["version"] = 1;
+    limits["packet"] = host ? int(host->maximumPacketSize) : ENET_HOST_DEFAULT_MAXIMUM_PACKET_SIZE;
+    limits["waiting"] = host ? int(host->maximumWaitingData) : ENET_HOST_DEFAULT_MAXIMUM_WAITING_DATA;
+    limits["overhead"] = ENET_INCOMING_COMMAND_OVERHEAD;
+    limits["unreliable_guard"] = true;
+    limits["dtls_guard"] = true;
+    return limits;
+}
