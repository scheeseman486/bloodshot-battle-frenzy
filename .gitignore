/tools/cache/
/tools/vendor/
/game/.godot/
/game/addons/bloodshot_audio/bin/
/native/audio/build/
**/__pycache__/
*.pyc

# Credentials and local profile state are never source inputs.
.env
.env.*
.netrc
.npmrc
.pypirc
.aws/
.ssh/
.gnupg/
.azure/
.gcloud/
network-private/
user-data/
